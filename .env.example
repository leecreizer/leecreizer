# 업비트 API 키 (https://upbit.com/mypage/open_api_management)
UPBIT_ACCESS_KEY=your-access-key
UPBIT_SECRET_KEY=your-secret-key

# 매매 대상: 단일 코인은 TICKER, 멀티코인은 TICKERS(콤마 구분). TICKERS 가 우선.
TICKER=KRW-BTC
TICKERS=                # 예: KRW-BTC,KRW-ETH,KRW-SOL

# 전략 파라미터
BREAKOUT_K=0.5
MA_WINDOW=0             # 0 이면 이동평균 필터 미사용

# 리스크 관리
INVEST_RATIO=0.9995     # 매수 시 사용할 KRW 비율 (수수료 감안)
STOP_LOSS_PCT=0.05      # 진입가 대비 -5% 손절
TRAIL_STOP_PCT=0.0      # 당일 고점 대비 하락 청산 (0=미사용, 예: 0.05)
TRAIL_MIN_PROFIT_PCT=0.0  # 트레일링 발동 최소 수익 (예: 0.005=+0.5%)
FEE=0.0005              # 업비트 거래 수수료 0.05%

# AI 게이트 / 상태 영속화
USE_AI_GATE=false       # true 면 Prophet 예측가 >= 현재가 일 때만 매수 (prophet 설치 필요)
STATE_PATH=state.json   # 포지션 상태 저장 파일

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
